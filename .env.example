# ---- Database ----
# MongoDB Atlas connection string, or local: mongodb://127.0.0.1:27017/buildlog
MONGODB_URI=

# ---- Authentication (Auth.js v5) ----
# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App -> https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional single-admin allowlist. When set, only this GitHub account's email
# can access /admin and the mutating API routes. Leave blank to allow any
# authenticated user (fine for local dev).
ADMIN_EMAIL=

# ---- Application ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Author profile (used for seed content + article bylines) ----
NEXT_PUBLIC_AUTHOR_NAME=Harsh
NEXT_PUBLIC_AUTHOR_HANDLE=@harshxdotin
NEXT_PUBLIC_AUTHOR_WEBSITE=https://harshx.in
NEXT_PUBLIC_GITHUB_USERNAME=RajHarsh03
NEXT_PUBLIC_AUTHOR_AVATAR=https://github.com/RajHarsh03.png
